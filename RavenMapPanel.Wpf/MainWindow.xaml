<Window x:Class="RavenMapPanel.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:RavenMapPanel"
        Title="Raven Map Panel" Icon="Assets/raven-brand-v2.ico" WindowStartupLocation="CenterScreen" WindowState="Maximized" MinWidth="1280" MinHeight="760">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility"/>
        <Geometry x:Key="IconHome">M3,11 L12,3 L21,11 M5.5,9.5 V21 H18.5 V9.5 M9.5,21 V14 H14.5 V21</Geometry>
        <Geometry x:Key="IconMap">M3,5 L9,3 L15,5 L21,3 V19 L15,21 L9,19 L3,21 Z M9,3 V19 M15,5 V21</Geometry>
        <Geometry x:Key="IconMonument">M4,20 H20 M6,20 V9 H18 V20 M4,9 H20 L17,4 H7 Z M9,12 V17 M12,12 V17 M15,12 V17</Geometry>
        <Geometry x:Key="IconLayers">M12,3 L21,8 L12,13 L3,8 Z M4,12 L12,17 L20,12 M4,16 L12,21 L20,16</Geometry>
        <Geometry x:Key="IconWorld">M12,3 A9,9 0 1 0 12,21 A9,9 0 1 0 12,3 M3,12 H21 M12,3 C16,7 16,17 12,21 M12,3 C8,7 8,17 12,21</Geometry>
        <Geometry x:Key="IconHistory">M4,5 V10 H9 M5,9 A8,8 0 1 1 5.5,17 M12,7 V12 L16,14</Geometry>
        <Geometry x:Key="IconCheck">M4,13 L9,18 L20,6 M4,4 H20 V20 H4 Z</Geometry>
        <Geometry x:Key="IconLogs">M5,6 H19 M5,12 H19 M5,18 H15 M2.5,6 H2.6 M2.5,12 H2.6 M2.5,18 H2.6</Geometry>
        <Geometry x:Key="IconSettings">M12,8 A4,4 0 1 0 12,16 A4,4 0 1 0 12,8 M12,3 V5 M12,19 V21 M3,12 H5 M19,12 H21 M5.6,5.6 L7,7 M17,17 L18.4,18.4 M18.4,5.6 L17,7 M7,17 L5.6,18.4</Geometry>
        <Style x:Key="NavPath" TargetType="Path">
            <Setter Property="Stroke" Value="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}"/>
            <Setter Property="StrokeThickness" Value="1.7"/><Setter Property="StrokeStartLineCap" Value="Round"/><Setter Property="StrokeEndLineCap" Value="Round"/><Setter Property="StrokeLineJoin" Value="Round"/>
            <Setter Property="Width" Value="19"/><Setter Property="Height" Value="19"/><Setter Property="Stretch" Value="Uniform"/>
        </Style>
        <DataTemplate x:Key="MonumentRowTemplate" DataType="{x:Type local:MonumentRuleViewModel}">
            <Border Background="#101720" BorderBrush="#26333F" BorderThickness="1" CornerRadius="8" Padding="10,8" Margin="0,0,0,7">
                <Grid MinHeight="52">
                    <Grid.ColumnDefinitions><ColumnDefinition Width="48"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="46"/></Grid.ColumnDefinitions>
                    <Border Width="40" Height="40" CornerRadius="8" Background="#171F29" BorderBrush="#2D3946" BorderThickness="1"><Image Source="{Binding IconPath}" Margin="5" Stretch="Uniform"/></Border>
                    <StackPanel Grid.Column="1" Margin="10,2,12,0"><TextBlock Text="{Binding Name}" Foreground="{StaticResource TextBrush}" FontWeight="SemiBold" FontSize="13" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding Category}" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/></StackPanel>
                    <Button Grid.Column="2" Content="{Binding PrefabModeText}" Foreground="{Binding PrefabModeColor}" Background="#151E28" BorderBrush="#354452" Padding="9,5" Margin="3,0,8,0" FontSize="10" VerticalAlignment="Center" Tag="{Binding}" Click="TogglePrefab_Click" Visibility="{Binding CustomPrefabAvailable, Converter={StaticResource BoolToVisibility}}" ToolTip="Vanilla veya özel prefab"/>
                    <StackPanel Grid.Column="3" Orientation="Horizontal" VerticalAlignment="Center" Margin="4,0,9,0" Visibility="{Binding IsGodRock, Converter={StaticResource BoolToVisibility}}" ToolTip="God Rock hedef adedi">
                        <Button Content="−" Width="28" Height="28" Padding="0" Tag="{Binding}" Click="GodRockMinus_Click"/>
                        <Border Background="#171F29" BorderBrush="#3B4856" BorderThickness="1" CornerRadius="6" Margin="5,0" MinWidth="40" Height="28"><TextBlock Text="{Binding TargetCount}" Foreground="{StaticResource AccentSoftBrush}" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border>
                        <Button Content="+" Width="28" Height="28" Padding="0" Tag="{Binding}" Click="GodRockPlus_Click"/>
                    </StackPanel>
                    <Button Grid.Column="4" Content="{Binding StateSymbol}" Foreground="{Binding StateColor}" Background="{Binding StateBackground}" BorderBrush="{Binding StateBorderColor}" BorderThickness="1" FontSize="18" FontWeight="Bold" Width="38" Height="38" Padding="0" Tag="{Binding}" Click="CycleRule_Click" ToolTip="{Binding StateText}"/>
                </Grid>
            </Border>
        </DataTemplate>
        <Style x:Key="SectionTitle" TargetType="TextBlock"><Setter Property="Foreground" Value="#9DA9B6"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="FontSize" Value="10"/><Setter Property="Margin" Value="0,0,0,11"/></Style>
        <Style x:Key="PageTitle" TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource TextBrush}"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="FontSize" Value="28"/></Style>
        <Style x:Key="Metric" TargetType="TextBlock"><Setter Property="Foreground" Value="{StaticResource TextBrush}"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="FontSize" Value="23"/></Style>
    </Window.Resources>

    <Grid Background="{StaticResource WindowBrush}">
        <Grid.RowDefinitions><RowDefinition Height="54"/><RowDefinition Height="*"/><RowDefinition Height="28"/></Grid.RowDefinitions>
        <Border Grid.Row="0" Background="#0D1218" BorderBrush="#26323D" BorderThickness="0,0,0,1">
            <Grid Margin="14,0"><Grid.ColumnDefinitions><ColumnDefinition Width="232"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center"><Border Width="36" Height="36" CornerRadius="9" Background="#090F16" BorderBrush="#5B3328" BorderThickness="1"><Image Source="Assets/raven-brand-v2.png" Width="33" Height="33" Stretch="UniformToFill"/></Border><StackPanel Margin="10,0,0,0"><TextBlock Text="Raven Map Panel" Foreground="#F5F8FB" FontWeight="Bold" FontSize="16"/><TextBlock Text="V3.7.0" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" FontSize="9"/></StackPanel></StackPanel>
                <Border Grid.Column="1" Background="#111A23" BorderBrush="#263542" BorderThickness="1" CornerRadius="7" Padding="11,6" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="18,0,0,0"><StackPanel Orientation="Horizontal"><TextBlock Text="AKTİF HARİTA" Foreground="{StaticResource MutedBrush}" FontSize="9" FontWeight="SemiBold" VerticalAlignment="Center"/><TextBlock x:Name="ProjectTitle" Text="Yeni harita" Foreground="#EAF2F8" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0,0,0"/></StackPanel></Border>
                <Border Grid.Column="2" Background="#13372E" CornerRadius="7" Padding="12,7" VerticalAlignment="Center"><TextBlock x:Name="TopStatus" Text="Hazır" Foreground="{StaticResource SuccessBrush}" FontWeight="SemiBold" FontSize="11"/></Border>
            </Grid>
        </Border>

        <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="224"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
            <Border Grid.Column="0" Background="#0B1118" BorderBrush="#26323D" BorderThickness="0,0,1,0" Padding="14,16">
                <Grid><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                    <Border Background="#15212B" BorderBrush="#2B3B49" BorderThickness="1" CornerRadius="11" Padding="13" Margin="0,0,0,15">
                        <StackPanel><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions><Border Width="36" Height="36" CornerRadius="10" Background="#2B1B17" BorderBrush="#9B442A" BorderThickness="1" VerticalAlignment="Top"><Grid><Ellipse Width="25" Height="25" Fill="#40170E" Stroke="#D85B32" StrokeThickness="1"/><Path Data="{StaticResource IconMap}" Stroke="#FFB08E" StrokeThickness="1.65" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="17" Height="17" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center"/></Grid></Border><StackPanel Grid.Column="1" Margin="9,0,0,0"><TextBlock Text="AKTİF HARİTA" Foreground="{StaticResource AccentBrush}" FontSize="9" FontWeight="Bold"/><TextBlock x:Name="SidebarProjectName" Text="Yeni Raven Haritası" Foreground="#F2F6FA" FontSize="15" FontWeight="Bold" Margin="0,5,0,0" TextTrimming="CharacterEllipsis"/><TextBlock x:Name="SidebarProjectPath" Text="Henüz kaydedilmedi" Foreground="#91A6B7" FontSize="10" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/></StackPanel></Grid><UniformGrid Columns="3" Margin="0,12,0,0"><Button Style="{StaticResource ButtonBase}" Content="Yükle" Padding="4,6" Margin="0,0,3,0" FontSize="10" Click="OpenProject_Click" ToolTip="Harita ayar dosyası yükle"/><Button Style="{StaticResource PrimaryButton}" Content="Kaydet" Padding="4,6" Margin="2,0" FontSize="10" Click="SaveProject_Click" ToolTip="Harita ayarlarını kaydet"/><Button Style="{StaticResource ButtonBase}" Content="Farklı" Padding="4,6" Margin="3,0,0,0" FontSize="10" Click="SaveProjectAs_Click" ToolTip="Ayarları farklı isimle kaydet"/></UniformGrid></StackPanel>
                    </Border>
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto"><StackPanel>
                        <TextBlock Text="STÜDYO" Style="{StaticResource SectionTitle}" Margin="8,3,0,6"/>
                        <Button x:Name="NavDashboard" Style="{StaticResource NavButton}" Tag="Dashboard" Click="Navigate_Click"><StackPanel Orientation="Horizontal"><Path Style="{StaticResource NavPath}" Data="{StaticResource IconHome}"/><TextBlock Text="Başlangıç" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Margin="12,0,0,0" VerticalAlignment="Center"/></StackPanel></Button>
                        <Button x:Name="NavStudio" Style="{StaticResource NavButton}" Tag="Studio" Click="Navigate_Click"><StackPanel Orientation="Horizontal"><Path Style="{StaticResource NavPath}" Data="{StaticResource IconMap}"/><TextBlock Text="Harita Oluştur" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Margin="12,0,0,0" VerticalAlignment="Center"/></StackPanel></Button>
                        <TextBlock Text="İÇERİK" Style="{StaticResource SectionTitle}" Margin="8,17,0,6"/>
                        <Button x:Name="NavMonuments" Style="{StaticResource NavButton}" Tag="Monuments" Click="Navigate_Click"><StackPanel Orientation="Horizontal"><Path Style="{StaticResource NavPath}" Data="{StaticResource IconMonument}"/><TextBlock Text="Monument Kuralları" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Margin="12,0,0,0" VerticalAlignment="Center"/></StackPanel></Button>
                        <Button x:Name="NavIcons" Style="{StaticResource NavButton}" Tag="Icons" Click="Navigate_Click"><StackPanel Orientation="Horizontal"><Path Style="{StaticResource NavPath}" Data="{StaticResource IconLayers}"/><TextBlock Text="İkonlar ve Katmanlar" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Margin="12,0,0,0" VerticalAlignment="Center"/></StackPanel></Button>
                        <Button x:Name="NavAdvanced" Style="{StaticResource NavButton}" Tag="Advanced" Click="Navigate_Click"><StackPanel Orientation="Horizontal"><Path Style="{StaticResource NavPath}" Data="{StaticResource IconWorld}"/><TextBlock Text="Biyom &amp; Dünya" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Margin="12,0,0,0" VerticalAlignment="Center"/></StackPanel></Button>
                        <TextBlock Text="KONTROL" Style="{StaticResource SectionTitle}" Margin="8,17,0,6"/>
                        <Button x:Name="NavHistory" Style="{StaticResource NavButton}" Tag="History" Click="Navigate_Click"><StackPanel Orientation="Horizontal"><Path Style="{StaticResource NavPath}" Data="{StaticResource IconHistory}"/><TextBlock Text="Harita Geçmişi" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Margin="12,0,0,0" VerticalAlignment="Center"/></StackPanel></Button>
                        <Button x:Name="NavValidation" Style="{StaticResource NavButton}" Tag="Validation" Click="Navigate_Click"><StackPanel Orientation="Horizontal"><Path Style="{StaticResource NavPath}" Data="{StaticResource IconCheck}"/><TextBlock Text="Harita Doğrulama" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Margin="12,0,0,0" VerticalAlignment="Center"/></StackPanel></Button>
                        <Button x:Name="NavLogs" Style="{StaticResource NavButton}" Tag="Logs" Click="Navigate_Click"><StackPanel Orientation="Horizontal"><Path Style="{StaticResource NavPath}" Data="{StaticResource IconLogs}"/><TextBlock Text="Üretim Logları" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Margin="12,0,0,0" VerticalAlignment="Center"/></StackPanel></Button>
                        <Button x:Name="NavSettings" Style="{StaticResource NavButton}" Tag="Settings" Click="Navigate_Click"><StackPanel Orientation="Horizontal"><Path Style="{StaticResource NavPath}" Data="{StaticResource IconSettings}"/><TextBlock Text="Uygulama Ayarları" Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Margin="12,0,0,0" VerticalAlignment="Center"/></StackPanel></Button>
                    </StackPanel></ScrollViewer>
                    <Border Grid.Row="2" Background="#101923" BorderBrush="#263542" BorderThickness="1" CornerRadius="10" Padding="11" Margin="0,14,0,0"><StackPanel><TextBlock Text="HIZLI KLASÖRLER" Style="{StaticResource SectionTitle}"/><UniformGrid Columns="2"><Button Style="{StaticResource ButtonBase}" Content="Ayarlar" Padding="7" Margin="0,0,4,0" Click="OpenConfig_Click"/><Button Style="{StaticResource ButtonBase}" Content="Haritalar" Padding="7" Margin="4,0,0,0" Click="OpenMaps_Click"/></UniformGrid></StackPanel></Border>
                </Grid>
            </Border>

            <Grid Grid.Column="1" Margin="18">
                <!-- Dashboard -->
                <Grid x:Name="DashboardPage">
                    <Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="118"/><RowDefinition Height="168"/></Grid.RowDefinitions>
                    <Border CornerRadius="16" ClipToBounds="True" BorderBrush="#314251" BorderThickness="1"><Grid><Image x:Name="DashboardHeroImage" Source="Assets/backgrounds/arkaplan-5.jpg" Stretch="UniformToFill"/><Rectangle><Rectangle.Fill><LinearGradientBrush StartPoint="0,0.5" EndPoint="1,0.5"><GradientStop Color="#F20A1017" Offset="0"/><GradientStop Color="#C20A1017" Offset="0.46"/><GradientStop Color="#300A1017" Offset="1"/></LinearGradientBrush></Rectangle.Fill></Rectangle><Rectangle><Rectangle.Fill><LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1"><GradientStop Color="#00000000" Offset="0.55"/><GradientStop Color="#C90A1017" Offset="1"/></LinearGradientBrush></Rectangle.Fill></Rectangle>
                        <Grid Margin="48,38"><Grid.ColumnDefinitions><ColumnDefinition Width="3*"/><ColumnDefinition Width="2*"/></Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center"><Border Background="#193C36" CornerRadius="12" Padding="12,5" HorizontalAlignment="Left"><TextBlock Text="RAVEN MAP GENERATION STUDIO" Foreground="#8FE2CE" FontSize="10" FontWeight="Bold"/></Border><TextBlock Text="Raven haritalarını&#x0a;tek merkezden üretin" Foreground="#FFFFFF" FontSize="43" LineHeight="48" FontWeight="Bold" Margin="0,18,0,0"/><TextBlock Text="Harita kuralları, monument seçimleri, ikon katmanları ve doğrulama tek bir profesyonel çalışma alanında." Foreground="#D0DBE4" FontSize="15" MaxWidth="670" TextWrapping="Wrap" Margin="0,14,0,23" HorizontalAlignment="Left"/><StackPanel Orientation="Horizontal"><Button Style="{StaticResource PrimaryButton}" Content="Harita Oluşturmaya Başla  →" FontWeight="Bold" Padding="18,11" Click="GoStudio_Click" Margin="0,0,9,0"/><Button Style="{StaticResource ButtonBase}" Content="Son Haritayı Aç" Padding="16,11" Click="LoadLatestMap_Click"/></StackPanel></StackPanel>
                        </Grid>
                    </Grid></Border>
                    <Grid Grid.Row="1" Margin="0,10,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Border Style="{StaticResource Card}" Margin="0,0,7,0" Padding="16"><StackPanel><TextBlock Text="AKTİF HARİTA" Style="{StaticResource SectionTitle}"/><TextBlock x:Name="DashMapName" Text="Raven Harita" Style="{StaticResource Metric}"/><TextBlock x:Name="DashSeed" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/></StackPanel></Border><Border Grid.Column="1" Style="{StaticResource Card}" Margin="3,0,4,0" Padding="16"><StackPanel><TextBlock Text="KURAL SETİ" Style="{StaticResource SectionTitle}"/><TextBlock x:Name="DashRules" Text="0 özel kural" Style="{StaticResource Metric}"/><TextBlock Text="✓ Olsun  ·  × Olmasın  ·  ? İsteğe bağlı" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/></StackPanel></Border><Border Grid.Column="2" Style="{StaticResource Card}" Margin="7,0,0,0" Padding="16"><StackPanel><TextBlock Text="DOSYA DÜZENİ" Style="{StaticResource SectionTitle}"/><TextBlock Text="Ayarlar + Haritalar" Style="{StaticResource Metric}"/><TextBlock Text="Ayar, MAP ve PNG dosyaları düzenli tutulur" Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0"/></StackPanel></Border></Grid>
                    <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,10,0,0" Padding="13"><Grid><Grid.RowDefinitions><RowDefinition Height="30"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid><TextBlock Text="SON AYAR KAYITLARI" Style="{StaticResource SectionTitle}"/><TextBlock Text="Kayıtlı harita ayarları" Foreground="{StaticResource MutedBrush}" FontSize="10" HorizontalAlignment="Right"/></Grid><ListBox x:Name="RecentProjectsList" Grid.Row="1" Background="Transparent" BorderThickness="0" Foreground="{StaticResource TextBrush}" MouseDoubleClick="RecentProject_DoubleClick" ScrollViewer.HorizontalScrollBarVisibility="Auto" ScrollViewer.VerticalScrollBarVisibility="Disabled"><ListBox.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal"/></ItemsPanelTemplate></ListBox.ItemsPanel><ListBox.ItemTemplate><DataTemplate><Border Width="330" Height="92" Background="#151F29" BorderBrush="#2B3A47" BorderThickness="1" CornerRadius="9" Padding="12" Margin="0,0,9,0"><Grid><Grid.ColumnDefinitions><ColumnDefinition Width="38"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><Border Width="31" Height="31" CornerRadius="8" Background="#13372E" VerticalAlignment="Top"><TextBlock Text="◆" Foreground="{StaticResource AccentBrush}" HorizontalAlignment="Center" VerticalAlignment="Center"/></Border><StackPanel Grid.Column="1" Margin="9,0,8,0"><TextBlock Text="{Binding Name}" Foreground="#F2F6FA" FontWeight="Bold" FontSize="13" TextTrimming="CharacterEllipsis"/><TextBlock Text="{Binding SavedAt}" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,4,0,0"/><TextBlock Text="{Binding Location}" Foreground="#7891A4" FontSize="9" Margin="0,3,0,0" TextTrimming="CharacterEllipsis"/></StackPanel><Button Grid.Column="2" Style="{StaticResource ButtonBase}" Content="Yükle" Padding="10,5" VerticalAlignment="Center" Tag="{Binding}" Click="OpenRecentProject_Click"/></Grid></Border></DataTemplate></ListBox.ItemTemplate></ListBox></Grid></Border>
                </Grid>

                <!-- Studio -->
                <Grid x:Name="StudioPage" Visibility="Collapsed">
                    <Grid.RowDefinitions><RowDefinition Height="82"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid Margin="2,0,2,10">
                        <StackPanel VerticalAlignment="Center"><TextBlock Text="Harita Oluştur" Style="{StaticResource PageTitle}"/><TextBlock Text="Dünya ayarlarını belirleyin ve haritayı üretin." Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0"/></StackPanel>
                        <Button Style="{StaticResource ButtonBase}" Content="＋ Yeni Harita" Padding="15,9" HorizontalAlignment="Right" VerticalAlignment="Center" Click="NewProject_Click" ToolTip="Yeni harita ayarları oluştur"/>
                    </Grid>
                    <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="430"/></Grid.ColumnDefinitions>
                        <Grid Margin="0,0,12,0"><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="106"/></Grid.RowDefinitions>
                            <Border Background="#061019" BorderBrush="#2A3743" BorderThickness="1" CornerRadius="12" ClipToBounds="True">
                                <Grid><local:MapViewport x:Name="MapView" Margin="1"/>
                                    <Border HorizontalAlignment="Left" VerticalAlignment="Top" Background="#E00D131B" BorderBrush="#34414F" BorderThickness="1" CornerRadius="8" Padding="6" Margin="12"><StackPanel Orientation="Horizontal"><Button Style="{StaticResource ButtonBase}" Content="＋" Width="38" Height="36" Padding="0" Click="ZoomIn_Click" ToolTip="Yakınlaştır"/><Button Style="{StaticResource ButtonBase}" Content="−" Width="38" Height="36" Padding="0" Margin="5,0,0,0" Click="ZoomOut_Click" ToolTip="Uzaklaştır"/><Button Style="{StaticResource ButtonBase}" Content="↙" Width="38" Height="36" Padding="0" Margin="5,0,0,0" Click="FitMap_Click" ToolTip="Ekrana sığdır"/></StackPanel></Border>
                                    <Border HorizontalAlignment="Right" VerticalAlignment="Top" Background="#E00D131B" BorderBrush="#34414F" BorderThickness="1" CornerRadius="8" Padding="12,8" Margin="12"><StackPanel Orientation="Horizontal"><TextBlock x:Name="MapCanvasStatus" Text="Önizleme bekleniyor" Foreground="#C7D0DA" Margin="0,0,12,0"/><TextBlock x:Name="ZoomLabel" Text="100%" Foreground="{StaticResource AccentSoftBrush}" FontWeight="SemiBold"/></StackPanel></Border>
                                    <Border x:Name="MarkerDetailsCard" Visibility="Collapsed" HorizontalAlignment="Left" VerticalAlignment="Bottom" Background="#FA0D141C" BorderBrush="#485868" BorderThickness="1" CornerRadius="12" Margin="14" Width="450" ClipToBounds="True">
                                        <Grid>
                                            <Grid.RowDefinitions><RowDefinition Height="230"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                            <Grid Background="#070C11">
                                                <Image x:Name="MarkerGalleryImage" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                                                <Rectangle><Rectangle.Fill><LinearGradientBrush StartPoint="0.5,0" EndPoint="0.5,1"><GradientStop Color="#00000000" Offset="0.48"/><GradientStop Color="#DB080D12" Offset="1"/></LinearGradientBrush></Rectangle.Fill></Rectangle>
                                                <Border x:Name="MarkerFallbackBadge" Visibility="Collapsed" Background="#D91A232D" BorderBrush="#556473" BorderThickness="1" CornerRadius="15" Padding="12,6" HorizontalAlignment="Center" VerticalAlignment="Center"><TextBlock Text="GALERİ GÖRSELİ BEKLENİYOR" Foreground="#B6C4D0" FontWeight="SemiBold" FontSize="10"/></Border>
                                                <Button Style="{StaticResource ButtonBase}" Content="×" Width="31" Height="31" Padding="0" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="10" Click="CloseMarkerDetails_Click"/>
                                                <Button x:Name="MarkerGalleryPrevious" Style="{StaticResource ButtonBase}" Content="‹" Width="34" Height="48" Padding="0" FontSize="24" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,0" Click="MarkerGalleryPrevious_Click"/>
                                                <Button x:Name="MarkerGalleryNext" Style="{StaticResource ButtonBase}" Content="›" Width="34" Height="48" Padding="0" FontSize="24" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="10,0" Click="MarkerGalleryNext_Click"/>
                                                <Border Background="#D910171F" CornerRadius="12" Padding="9,4" HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="10"><TextBlock x:Name="MarkerGalleryCounter" Text="1 / 1" Foreground="#EFF4F8" FontSize="10" FontWeight="SemiBold"/></Border>
                                            </Grid>
                                            <Grid Grid.Row="1" Margin="16,13,16,15">
                                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
                                                <TextBlock x:Name="MarkerNameText" Text="Monument" Foreground="#F3F6F9" FontWeight="SemiBold" FontSize="18" TextTrimming="CharacterEllipsis"/>
                                                <TextBlock x:Name="MarkerInfoText" Grid.Row="1" Foreground="{StaticResource AccentSoftBrush}" FontSize="10" FontWeight="SemiBold" Margin="0,5,0,0"/>
                                                <TextBlock x:Name="MarkerDescriptionText" Grid.Row="2" Foreground="#AEBBC7" FontSize="11" LineHeight="17" TextWrapping="Wrap" Margin="0,9,0,0"/>
                                                <Grid Grid.Row="3" Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                    <Button x:Name="MarkerRuleButton" Style="{StaticResource ButtonBase}" Content="Monument Kuralına Git" Padding="11,6" Click="MarkerRule_Click"/>
                                                    <TextBlock x:Name="MarkerGalleryCaption" Grid.Column="1" Foreground="#738799" FontSize="9" Margin="12,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                                                    <Button x:Name="MarkerGalleryFolderButton" Grid.Column="2" Style="{StaticResource ButtonBase}" Content="Galeri Klasörü" Padding="11,6" Click="OpenMarkerGallery_Click" ToolTip="Bu monument için PNG/JPG görsellerini aç"/>
                                                </Grid>
                                            </Grid>
                                        </Grid>
                                    </Border>
                                </Grid>
                            </Border>
                            <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,10,0,0" Padding="12"><DockPanel><DockPanel DockPanel.Dock="Top"><Button DockPanel.Dock="Right" Style="{StaticResource ButtonBase}" Content="Temizle" Padding="9,4" Click="ClearLog_Click"/><TextBlock Text="ÜRETİM DURUMU" Style="{StaticResource SectionTitle}" Margin="0,4,0,0"/></DockPanel><TextBox x:Name="StudioLog" IsReadOnly="True" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" Background="Transparent" BorderThickness="0" Foreground="#AFC9BC" FontFamily="Cascadia Mono" FontSize="10.5" Padding="0"/></DockPanel></Border>
                        </Grid>
                        <Grid Grid.Column="1"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="104"/></Grid.RowDefinitions>
                            <Border Style="{StaticResource Card}" Padding="16"><StackPanel><Grid Margin="0,0,0,13"><TextBlock Text="DÜNYA AYARLARI" Style="{StaticResource SectionTitle}"/><Button Style="{StaticResource ButtonBase}" Content="Rust Klasörü" Padding="9,4" HorizontalAlignment="Right" Click="BrowseRust_Click"/></Grid><TextBlock Text="Harita adı" Foreground="{StaticResource MutedBrush}"/><TextBox x:Name="MapNameBox" Margin="0,5,0,12"/>
                                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="2*"/><ColumnDefinition Width="12"/><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition Width="70"/></Grid.ColumnDefinitions><StackPanel><TextBlock Text="İlk seed" Foreground="{StaticResource MutedBrush}"/><Grid Margin="0,5,0,0"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="42"/></Grid.ColumnDefinitions><TextBox x:Name="SeedBox"/><Button Grid.Column="1" Style="{StaticResource ButtonBase}" Content="↻" Padding="0" Margin="5,0,0,0" Click="RandomSeed_Click" ToolTip="Rastgele seed"/></Grid></StackPanel><StackPanel Grid.Column="2"><TextBlock Text="Dünya boyutu" Foreground="{StaticResource MutedBrush}"/><TextBox x:Name="SizeBox" Margin="0,5,0,0"/></StackPanel><StackPanel Grid.Column="4"><TextBlock Text="Harita adedi" Foreground="{StaticResource MutedBrush}"/><ComboBox x:Name="GenerationCountBox" Margin="0,5,0,0" SelectedIndex="0"><ComboBoxItem Content="1"/><ComboBoxItem Content="2"/><ComboBoxItem Content="3"/><ComboBoxItem Content="4"/><ComboBoxItem Content="5"/><ComboBoxItem Content="6"/><ComboBoxItem Content="7"/></ComboBox></StackPanel></Grid>
                                <Border Style="{StaticResource SubCard}" Margin="0,14,0,0"><StackPanel><TextBlock Text="DÜNYA ÖZELLİKLERİ" Style="{StaticResource SectionTitle}"/><UniformGrid Columns="2" Rows="4"><CheckBox x:Name="RoadsCheck" Content="Yollar"/><CheckBox x:Name="RiversCheck" Content="Nehirler"/><CheckBox x:Name="PowerCheck" Content="Elektrik hatları"/><CheckBox x:Name="RailsCheck" Content="Raylar"/><CheckBox x:Name="MetroCheck" Content="Yer altı rayları"/><CheckBox x:Name="OasisCheck" Content="Vahalar"/><CheckBox x:Name="CanyonCheck" Content="Kanyonlar"/><CheckBox x:Name="LakesCheck" Content="Göller"/></UniformGrid></StackPanel></Border>
                                <Button x:Name="GenerateButton" Style="{StaticResource PrimaryButton}" Content="HARİTAYI ÜRET" FontWeight="Bold" FontSize="13" Padding="14,12" Click="Generate_Click" Margin="0,14,0,0"/>
                                <Border Style="{StaticResource SubCard}" Margin="0,10,0,0"><StackPanel><Grid><TextBlock x:Name="SideProgressTitle" Text="Hazır" FontWeight="SemiBold"/><Button x:Name="CancelButton" Style="{StaticResource ButtonBase}" Content="İptal" Padding="8,3" HorizontalAlignment="Right" IsEnabled="False" Click="Cancel_Click"/></Grid><ProgressBar x:Name="GenerationProgress" Height="6" Margin="0,9,0,7"/><TextBlock x:Name="SideProgressDetail" Text="" Foreground="{StaticResource MutedBrush}" FontSize="10" TextWrapping="Wrap"/></StackPanel></Border>
                            </StackPanel></Border>
                            <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,10,0,0" Padding="12"><DockPanel><StackPanel DockPanel.Dock="Top"><Grid><TextBlock Text="MONUMENT KURALLARI" Style="{StaticResource SectionTitle}"/><Button Style="{StaticResource ButtonBase}" Content="Tümünü Yönet" Padding="8,4" HorizontalAlignment="Right" Click="GoMonuments_Click"/></Grid><TextBox x:Name="QuickSearch" ToolTip="Monument ara" TextChanged="Search_TextChanged" Margin="0,0,0,7"/></StackPanel><ListBox x:Name="QuickMonumentList" ItemsSource="{Binding MonumentView}" ItemTemplate="{StaticResource MonumentRowTemplate}" Background="Transparent" BorderThickness="0" ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"/></DockPanel></Border>
                            <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,10,0,0" Padding="12"><StackPanel><TextBlock Text="DIŞA AKTAR" Style="{StaticResource SectionTitle}"/><Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><Button x:Name="ExportPngButton" Style="{StaticResource ButtonBase}" Content="PNG Kaydet" IsEnabled="False" Click="ExportPng_Click" Margin="0,0,4,0"/><Button x:Name="ExportMapButton" Grid.Column="1" Style="{StaticResource ButtonBase}" Content="MAP Kaydet" IsEnabled="False" Click="ExportMap_Click" Margin="4,0,0,0"/></Grid></StackPanel></Border>
                        </Grid>
                    </Grid>
                </Grid>

                <!-- Advanced generation -->
                <Grid x:Name="AdvancedPage" Visibility="Collapsed">
                    <Grid.RowDefinitions><RowDefinition Height="86"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid Margin="2,0,2,12">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Biyom ve Dünya Dağılımı" Style="{StaticResource PageTitle}"/>
                            <TextBlock Text="Haritanın iklim dağılımını, ilerleme bölgelerini ve desteklenen monument görünümlerini ayarlayın." Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0"/>
                        </StackPanel>
                    </Grid>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <Grid HorizontalAlignment="Stretch">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="1.18*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="0.92*"/>
                                <ColumnDefinition Width="14"/>
                                <ColumnDefinition Width="1.05*"/>
                            </Grid.ColumnDefinitions>

                            <!-- BIOME -->
                            <Border Grid.Column="0" Style="{StaticResource Card}" VerticalAlignment="Top">
                                <StackPanel>
                                    <Grid Margin="0,0,0,12">
                                        <StackPanel>
                                            <TextBlock Text="BİYOM DAĞILIMI" Style="{StaticResource SectionTitle}" Margin="0,0,0,5"/>
                                            <TextBlock Text="Haritanın iklim bölgelerinin göreli payını belirler." Foreground="#C5CED7" FontSize="13" FontWeight="SemiBold"/>
                                        </StackPanel>
                                        <Button Style="{StaticResource ButtonBase}" Content="Varsayılan" Padding="11,6" HorizontalAlignment="Right" VerticalAlignment="Top" Click="ResetBiome_Click"/>
                                    </Grid>

                                    <Border Background="#111A23" BorderBrush="#2A3947" BorderThickness="1" CornerRadius="8" Padding="11" Margin="0,0,0,12">
                                        <TextBlock Text="Çöl, Ilıman, Tundra ve Kar değerleri kendi aralarında 100'e oranlanır. Jungle oranı bu dört biyomdan ayrı uygulanır." Foreground="#9FB0BF" FontSize="11" TextWrapping="Wrap"/>
                                    </Border>

                                    <Border Style="{StaticResource SubCard}" Margin="0,0,0,8">
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="145"/><ColumnDefinition/><ColumnDefinition Width="58"/></Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center"><TextBlock Text="Çöl" FontWeight="SemiBold" FontSize="13"/><TextBlock Text="Arid · kurak alan" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,2,0,0"/></StackPanel>
                                            <Slider x:Name="BiomeAridSlider" Grid.Column="1" Minimum="0" Maximum="100" TickFrequency="1" Height="22" Margin="12,0" ValueChanged="AdvancedValue_Changed" ToolTip="Çöl / Arid biyomunun ana biyomlar içindeki göreli ağırlığı"/>
                                            <TextBlock x:Name="BiomeAridValue" Grid.Column="2" HorizontalAlignment="Right" Foreground="{StaticResource AccentSoftBrush}" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                    <Border Style="{StaticResource SubCard}" Margin="0,0,0,8">
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="145"/><ColumnDefinition/><ColumnDefinition Width="58"/></Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center"><TextBlock Text="Ilıman" FontWeight="SemiBold" FontSize="13"/><TextBlock Text="Temperate · yeşil alan" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,2,0,0"/></StackPanel>
                                            <Slider x:Name="BiomeTemperateSlider" Grid.Column="1" Minimum="0" Maximum="100" TickFrequency="1" Height="22" Margin="12,0" ValueChanged="AdvancedValue_Changed" ToolTip="Ilıman / Temperate biyomunun ana biyomlar içindeki göreli ağırlığı"/>
                                            <TextBlock x:Name="BiomeTemperateValue" Grid.Column="2" HorizontalAlignment="Right" Foreground="{StaticResource AccentSoftBrush}" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                    <Border Style="{StaticResource SubCard}" Margin="0,0,0,8">
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="145"/><ColumnDefinition/><ColumnDefinition Width="58"/></Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center"><TextBlock Text="Tundra" FontWeight="SemiBold" FontSize="13"/><TextBlock Text="Soğuk geçiş alanı" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,2,0,0"/></StackPanel>
                                            <Slider x:Name="BiomeTundraSlider" Grid.Column="1" Minimum="0" Maximum="100" TickFrequency="1" Height="22" Margin="12,0" ValueChanged="AdvancedValue_Changed" ToolTip="Tundra biyomunun ana biyomlar içindeki göreli ağırlığı"/>
                                            <TextBlock x:Name="BiomeTundraValue" Grid.Column="2" HorizontalAlignment="Right" Foreground="{StaticResource AccentSoftBrush}" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                    <Border Style="{StaticResource SubCard}" Margin="0,0,0,8">
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="145"/><ColumnDefinition/><ColumnDefinition Width="58"/></Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center"><TextBlock Text="Kar" FontWeight="SemiBold" FontSize="13"/><TextBlock Text="Arctic · kar ve buz" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,2,0,0"/></StackPanel>
                                            <Slider x:Name="BiomeArcticSlider" Grid.Column="1" Minimum="0" Maximum="100" TickFrequency="1" Height="22" Margin="12,0" ValueChanged="AdvancedValue_Changed" ToolTip="Arctic / Kar biyomunun ana biyomlar içindeki göreli ağırlığı"/>
                                            <TextBlock x:Name="BiomeArcticValue" Grid.Column="2" HorizontalAlignment="Right" Foreground="{StaticResource AccentSoftBrush}" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>
                                    <Border Background="#161B17" BorderBrush="#4B402C" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,2,0,0">
                                        <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="145"/><ColumnDefinition/><ColumnDefinition Width="58"/></Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center"><TextBlock Text="Jungle" FontWeight="SemiBold" FontSize="13" Foreground="#F0D3A2"/><TextBlock Text="Ana 4 biyomdan bağımsız" Foreground="#B8A98F" FontSize="10" Margin="0,2,0,0"/></StackPanel>
                                            <Slider x:Name="BiomeJungleSlider" Grid.Column="1" Minimum="0" Maximum="100" TickFrequency="1" Height="22" Margin="12,0" ValueChanged="AdvancedValue_Changed" ToolTip="Jungle oranı ana dört biyomdan ayrı uygulanır"/>
                                            <TextBlock x:Name="BiomeJungleValue" Grid.Column="2" HorizontalAlignment="Right" Foreground="#F0B567" FontWeight="Bold" FontSize="14" VerticalAlignment="Center"/>
                                        </Grid>
                                    </Border>

                                    <Border Background="#0E1B20" BorderBrush="#2B4650" BorderThickness="1" CornerRadius="8" Padding="11" Margin="0,12,0,0">
                                        <StackPanel><TextBlock Text="UYGULANACAK DAĞILIM" Foreground="#7FA6B4" FontSize="9" FontWeight="Bold" Margin="0,0,0,5"/><TextBlock x:Name="BiomeSummaryText" Foreground="#D8E2E9" FontSize="11" TextWrapping="Wrap"/></StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>
                            <!-- TIER -->
                            <Border Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top">
                                <StackPanel>
                                    <Grid Margin="0,0,0,12">
                                        <StackPanel>
                                            <TextBlock Text="İLERLEME BÖLGELERİ (TIER)" Style="{StaticResource SectionTitle}" Margin="0,0,0,5"/>
                                            <TextBlock Text="Tier, haritadaki başlangıç ve loot bölgelerinin dağılımını belirleyen Rust topolojisidir." Foreground="#C5CED7" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                        </StackPanel>
                                        <Button Style="{StaticResource ButtonBase}" Content="Varsayılan" Padding="11,6" HorizontalAlignment="Right" VerticalAlignment="Top" Click="ResetTier_Click"/>
                                    </Grid>

                                    <Border Background="#111A23" BorderBrush="#2A3947" BorderThickness="1" CornerRadius="8" Padding="12" Margin="0,0,0,12">
                                        <StackPanel>
                                            <TextBlock Text="NE DEĞİŞTİRİR?" Foreground="#8FA5B7" FontSize="9" FontWeight="Bold" Margin="0,0,0,5"/>
                                            <TextBlock Text="Bu değerler monument sayısı değildir. Haritada Tier 0, Tier 1 ve Tier 2 topolojilerinin kaplayacağı göreli alanı değiştirir. Bazı vanilla monumentler belirli bir Tier ister; bu yüzden bir Tier'i çok azaltmak o monumentlerin oluşma ihtimalini de düşürebilir." Foreground="#B7C4CF" FontSize="11" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource SubCard}" Margin="0,0,0,8" Padding="12">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="58"/></Grid.ColumnDefinitions>
                                                <TextBlock Text="Tier 0 · Başlangıç Bölgesi" FontWeight="SemiBold" FontSize="14" Foreground="#ECF2F6"/>
                                                <TextBlock x:Name="Tier0Value" Grid.Column="1" HorizontalAlignment="Right" Foreground="{StaticResource AccentSoftBrush}" FontWeight="Bold" FontSize="14"/>
                                            </Grid>
                                            <TextBlock Text="Yeni oyuncuların doğal doğma alanları Tier 0 topolojisine ihtiyaç duyar. Tier 0'ı çok düşürmek geçerli spawn alanlarını azaltabilir veya tamamen bozabilir." Foreground="{StaticResource MutedBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,4,0,9"/>
                                            <Slider x:Name="Tier0Slider" Minimum="0" Maximum="100" TickFrequency="1" Height="22" ValueChanged="AdvancedValue_Changed" ToolTip="Başlangıç ve oyuncu spawn bölgesinin göreli alanı"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource SubCard}" Margin="0,0,0,8" Padding="12">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="58"/></Grid.ColumnDefinitions>
                                                <TextBlock Text="Tier 1 · Orta Seviye Bölge" FontWeight="SemiBold" FontSize="14" Foreground="#ECF2F6"/>
                                                <TextBlock x:Name="Tier1Value" Grid.Column="1" HorizontalAlignment="Right" Foreground="{StaticResource AccentSoftBrush}" FontWeight="Bold" FontSize="14"/>
                                            </Grid>
                                            <TextBlock Text="Orta seviye ilerleme alanıdır. Vanilla monumentlerde Tier 0'a göre daha iyi loot kasalarının kullanılabildiği bölgeyi büyütür veya küçültür." Foreground="{StaticResource MutedBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,4,0,9"/>
                                            <Slider x:Name="Tier1Slider" Minimum="0" Maximum="100" TickFrequency="1" Height="22" ValueChanged="AdvancedValue_Changed" ToolTip="Orta seviye loot ve ilerleme bölgesinin göreli alanı"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Style="{StaticResource SubCard}" Margin="0,0,0,8" Padding="12">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="58"/></Grid.ColumnDefinitions>
                                                <TextBlock Text="Tier 2 · Yüksek Seviye Bölge" FontWeight="SemiBold" FontSize="14" Foreground="#ECF2F6"/>
                                                <TextBlock x:Name="Tier2Value" Grid.Column="1" HorizontalAlignment="Right" Foreground="{StaticResource AccentSoftBrush}" FontWeight="Bold" FontSize="14"/>
                                            </Grid>
                                            <TextBlock Text="Daha yüksek değerli loot bölgelerinin payını belirler. Vanilla monumentlerde daha iyi kasa katmanlarının kullanıldığı alanın göreli büyüklüğünü etkiler." Foreground="{StaticResource MutedBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,4,0,9"/>
                                            <Slider x:Name="Tier2Slider" Minimum="0" Maximum="100" TickFrequency="1" Height="22" ValueChanged="AdvancedValue_Changed" ToolTip="Yüksek seviye loot bölgesinin göreli alanı"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Background="#151B1A" BorderBrush="#4A3C2C" BorderThickness="1" CornerRadius="8" Padding="11" Margin="0,4,0,8">
                                        <StackPanel>
                                            <TextBlock Text="ÖNERİLEN DENGE" Foreground="#E0B36B" FontSize="9" FontWeight="Bold" Margin="0,0,0,5"/>
                                            <TextBlock Text="30 / 30 / 40 dengeli başlangıç değeridir. Özellikle Tier 0'ı sıfıra veya çok düşük seviyeye indirmeyin." Foreground="#D7C3A3" FontSize="10" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>

                                    <Border Background="#0E1B20" BorderBrush="#2B4650" BorderThickness="1" CornerRadius="8" Padding="11" Margin="0,0,0,0">
                                        <StackPanel>
                                            <TextBlock Text="UYGULANACAK ORAN" Foreground="#7FA6B4" FontSize="9" FontWeight="Bold" Margin="0,0,0,5"/>
                                            <TextBlock x:Name="TierSummaryText" Foreground="#D8E2E9" FontSize="11" TextWrapping="Wrap"/>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!-- CUSTOM PREFABS -->
                            <Border Grid.Column="4" Style="{StaticResource Card}" VerticalAlignment="Top">
                                <StackPanel>
                                    <TextBlock Text="ÖZEL MONUMENT GÖRÜNÜMLERİ" Style="{StaticResource SectionTitle}" Margin="0,0,0,5"/>
                                    <TextBlock Text="Desteklenen monumentlerde Vanilla veya panelle gelen özel sürümü seçin." Foreground="#C5CED7" FontSize="13" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                    <Border Background="#111A23" BorderBrush="#2A3947" BorderThickness="1" CornerRadius="8" Padding="11" Margin="0,12,0,12">
                                        <TextBlock Text="Özel prefab seçilince kural Olsun olarak işaretlenir. Seed içinde ilgili vanilla monument oluşursa özel sürümle değiştirilir." Foreground="#9FB0BF" FontSize="11" TextWrapping="Wrap"/>
                                    </Border>
                                    <ItemsControl ItemsSource="{Binding CustomPrefabItems}">
                                        <ItemsControl.ItemTemplate><DataTemplate>
                                            <Border Style="{StaticResource SubCard}" Margin="0,0,0,8" Padding="12">
                                                <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="126"/></Grid.ColumnDefinitions>
                                                    <StackPanel VerticalAlignment="Center"><TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="13" Foreground="#ECF2F6"/><TextBlock Text="Monument görünümü" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,3,0,0"/></StackPanel>
                                                    <Button Grid.Column="1" Content="{Binding PrefabModeText}" Foreground="{Binding PrefabModeColor}" Style="{StaticResource ButtonBase}" Tag="{Binding}" Click="TogglePrefab_Click" Padding="10,7"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate></ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <Border Background="#10211D" BorderBrush="#2C4D43" BorderThickness="1" CornerRadius="8" Padding="11" Margin="0,6,0,0">
                                        <TextBlock Text="Desteklenenler: Karakol, Haydut Kampı, Ahırlar ve Balıkçı Köyü" Foreground="#8ED6C1" FontSize="10" TextWrapping="Wrap"/>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </ScrollViewer>
                </Grid>

                <!-- Monument manager -->
                <Grid x:Name="MonumentsPage" Visibility="Collapsed">
                    <Grid.RowDefinitions><RowDefinition Height="82"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid Margin="2,0,2,10">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Monument Kuralları" Style="{StaticResource PageTitle}"/>
                            <TextBlock Text="Haritada bulunmasını istediğiniz veya istemediğiniz monumentleri belirleyin." Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0"/>
                        </StackPanel>
                        <Button Style="{StaticResource ButtonBase}" Content="Kuralları Sıfırla" HorizontalAlignment="Right" VerticalAlignment="Center" Click="ResetRules_Click"/>
                    </Grid>
                    <Border Grid.Row="1" Style="{StaticResource Card}" Padding="14">
                        <Grid>
                            <Grid.RowDefinitions><RowDefinition Height="48"/><RowDefinition Height="34"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="250"/><ColumnDefinition Width="220"/></Grid.ColumnDefinitions>
                                <TextBox x:Name="MonumentSearch" TextChanged="Search_TextChanged" ToolTip="Monument ara"/>
                                <ComboBox x:Name="CategoryBox" Grid.Column="1" Margin="10,0,0,0" SelectionChanged="Category_Changed" ToolTip="Kategoriye göre filtrele"/>
                                <ComboBox x:Name="StateFilterBox" Grid.Column="2" Margin="10,0,0,0" SelectionChanged="StateFilter_Changed" ToolTip="Kural durumuna göre filtrele"/>
                            </Grid>
                            <Grid Grid.Row="1" Margin="2,7,2,0">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Gösterilen:" Foreground="{StaticResource MutedBrush}" FontSize="10"/>
                                    <TextBlock x:Name="FilterCountText" Text="0" Foreground="#D8E0E7" FontWeight="SemiBold" FontSize="10" Margin="5,0,0,0"/>
                                </StackPanel>
                                <TextBlock Text="Olsun · Olmasın · İsteğe bağlı" Foreground="#718190" FontSize="10" HorizontalAlignment="Right"/>
                            </Grid>
                            <ListBox x:Name="FullMonumentList" Grid.Row="2" Margin="0,10,0,0" ItemsSource="{Binding MonumentView}" ItemTemplate="{StaticResource MonumentRowTemplate}" Background="Transparent" BorderThickness="0" ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"/>
                        </Grid>
                    </Border>
                </Grid>

                <!-- Icons -->
                <Grid x:Name="IconsPage" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="80"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid><StackPanel><TextBlock Text="İkonlar ve Harita Katmanları" Style="{StaticResource PageTitle}"/><TextBlock Text="Harita ikonlarını ve görünür katmanları yönetin." Foreground="{StaticResource MutedBrush}"/></StackPanel><Button Style="{StaticResource PrimaryButton}" Content="＋ Yeni Monument Ekle" HorizontalAlignment="Right" VerticalAlignment="Center" Click="AddMonument_Click"/></Grid>
                    <Grid Grid.Row="1"><Grid.ColumnDefinitions><ColumnDefinition Width="310"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <Border Style="{StaticResource Card}" Margin="0,0,10,0"><StackPanel><TextBlock Text="HARİTA GÖRÜNÜMÜ" Style="{StaticResource SectionTitle}"/><TextBlock Text="İkon boyutu"/><Slider x:Name="IconSizeSlider" Minimum="24" Maximum="72" Value="42" TickFrequency="2" IsSnapToTickEnabled="True" Margin="0,8" ValueChanged="IconSize_Changed"/><TextBlock x:Name="IconSizeLabel" Text="42 px" Foreground="{StaticResource AccentBrush}"/><CheckBox x:Name="ShowIconsCheck" Content="Raven ikonlarını göster" IsChecked="True" Checked="Layer_Changed" Unchecked="Layer_Changed" Margin="0,20,0,5"/><CheckBox x:Name="ShowEnvironmentCheck" Content="Çevre ve altyapı ikonlarını göster" IsChecked="True" Checked="Layer_Changed" Unchecked="Layer_Changed"/><Button Style="{StaticResource ButtonBase}" Content="Haritada Önizle" Margin="0,20,0,0" Click="GoStudio_Click"/><Border Background="#10231F" BorderBrush="#285044" BorderThickness="1" CornerRadius="7" Padding="11" Margin="0,20,0,0"><TextBlock Text="PNG · 64–512 px" Foreground="#D6A47F" TextWrapping="Wrap"/></Border></StackPanel></Border>
                        <Border Grid.Column="1" Style="{StaticResource Card}" Padding="12"><ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsControl ItemsSource="{Binding MonumentItems}"><ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel/></ItemsPanelTemplate></ItemsControl.ItemsPanel><ItemsControl.ItemTemplate><DataTemplate><Border Width="178" Height="146" Margin="6" Background="#121A23" BorderBrush="#2B3947" BorderThickness="1" CornerRadius="10"><Grid><Grid.RowDefinitions><RowDefinition Height="*"/><RowDefinition Height="28"/></Grid.RowDefinitions><StackPanel VerticalAlignment="Center"><Image Source="{Binding IconPath}" Width="72" Height="72" Stretch="Uniform"/><TextBlock Text="{Binding Name}" Foreground="#EAF2F8" FontWeight="SemiBold" TextAlignment="Center" TextTrimming="CharacterEllipsis" Margin="7,7,7,0"/></StackPanel><Border Grid.Row="1" Background="#111922" CornerRadius="0,0,8,8"><TextBlock Text="{Binding SourceLabel}" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" FontSize="10"/></Border></Grid></Border></DataTemplate></ItemsControl.ItemTemplate></ItemsControl></ScrollViewer></Border>
                    </Grid>
                </Grid>

                <!-- History and comparison -->
                <Grid x:Name="HistoryPage" Visibility="Collapsed">
                    <Grid.RowDefinitions><RowDefinition Height="82"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid Margin="2,0,2,10">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="Harita Geçmişi" Style="{StaticResource PageTitle}"/>
                            <TextBlock Text="Üretilen haritaları yeniden açın veya iki üretimin monument sonuçlarını karşılaştırın." Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0"/>
                        </StackPanel>
                        <Button Style="{StaticResource ButtonBase}" Content="Yenile" HorizontalAlignment="Right" VerticalAlignment="Center" Padding="14,8" Click="RefreshHistory_Click"/>
                    </Grid>
                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions><ColumnDefinition Width="1.05*"/><ColumnDefinition Width="14"/><ColumnDefinition Width="0.95*"/></Grid.ColumnDefinitions>

                        <Border Style="{StaticResource Card}" Padding="14">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="42"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                <Grid>
                                    <TextBlock Text="ÜRETİM GEÇMİŞİ" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/>
                                    <TextBlock x:Name="HistoryCountText" Text="0 kayıt" Foreground="{StaticResource MutedBrush}" FontSize="10" HorizontalAlignment="Right" VerticalAlignment="Center"/>
                                </Grid>
                                <ListBox x:Name="HistoryList" Grid.Row="1" Background="Transparent" BorderThickness="0" ScrollViewer.CanContentScroll="True">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border Background="#111A23" BorderBrush="#293744" BorderThickness="1" CornerRadius="9" Padding="12" Margin="0,0,0,8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                    <StackPanel>
                                                        <TextBlock Text="{Binding DisplayName}" Foreground="#EDF3F7" FontWeight="SemiBold" FontSize="13"/>
                                                        <TextBlock Text="{Binding GeneratedText}" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="0,4,0,0"/>
                                                        <StackPanel Orientation="Horizontal" Margin="0,7,0,0">
                                                            <TextBlock Text="{Binding SummaryText}" Foreground="#AEBBC6" FontSize="10"/>
                                                            <TextBlock Text="  ·  " Foreground="#566573" FontSize="10"/>
                                                            <TextBlock Text="{Binding ValidationText}" Foreground="{Binding ValidationColor}" FontSize="10" FontWeight="SemiBold"/>
                                                        </StackPanel>
                                                        <TextBlock Text="{Binding BackupText}" Foreground="#D9A36F" FontSize="9" Margin="0,5,0,0"/>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,0,0">
                                                        <Button Style="{StaticResource PrimaryButton}" Content="Haritayı Aç" Padding="11,6" Tag="{Binding}" Click="LoadHistory_Click"/>
                                                        <Button Style="{StaticResource ButtonBase}" Content="Klasörü Aç" Padding="11,6" Margin="0,6,0,0" Tag="{Binding}" Click="OpenHistoryFolder_Click"/>
                                                        <Button Style="{StaticResource ButtonBase}" Content="Yedeği Aç" Padding="11,6" Margin="0,6,0,0" Tag="{Binding}" Click="OpenHistoryBackup_Click" Visibility="{Binding HasBackup, Converter={StaticResource BoolToVisibility}}"/>
                                                    </StackPanel>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Border>

                        <Border Grid.Column="2" Style="{StaticResource Card}" Padding="16">
                            <Grid>
                                <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="42"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                                <StackPanel>
                                    <TextBlock Text="KARŞILAŞTIR" Style="{StaticResource SectionTitle}" Margin="0,0,0,5"/>
                                    <TextBlock Text="İki üretimi seçin; monument ve çevre öğelerinin adet farklarını görün." Foreground="#C5CED7" FontSize="12" TextWrapping="Wrap"/>
                                </StackPanel>
                                <Grid Grid.Row="1" Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition/></Grid.ColumnDefinitions>
                                    <StackPanel><TextBlock Text="Harita A" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="1,0,0,5"/><ComboBox x:Name="CompareABox" DisplayMemberPath="DisplayName"/></StackPanel>
                                    <StackPanel Grid.Column="2"><TextBlock Text="Harita B" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="1,0,0,5"/><ComboBox x:Name="CompareBBox" DisplayMemberPath="DisplayName"/></StackPanel>
                                </Grid>
                                <Grid Grid.Row="2" Margin="0,12,0,0">
                                    <TextBlock x:Name="CompareSummaryText" Text="Karşılaştırmak için iki üretim seçin." Foreground="{StaticResource MutedBrush}" FontSize="10" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,130,0"/>
                                    <Button Style="{StaticResource PrimaryButton}" Content="Karşılaştır" Padding="14,7" HorizontalAlignment="Right" Click="CompareHistory_Click"/>
                                </Grid>
                                <Grid Grid.Row="3" Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="56"/><ColumnDefinition Width="56"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                                    <TextBlock Text="Monument / Katman" Style="{StaticResource SectionTitle}" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="1" Text="A" Style="{StaticResource SectionTitle}" TextAlignment="Center" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="2" Text="B" Style="{StaticResource SectionTitle}" TextAlignment="Center" VerticalAlignment="Center"/>
                                    <TextBlock Grid.Column="3" Text="Fark" Style="{StaticResource SectionTitle}" TextAlignment="Center" VerticalAlignment="Center"/>
                                </Grid>
                                <ListBox x:Name="ComparisonList" Grid.Row="4" Background="Transparent" BorderThickness="0">
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="#24313C" BorderThickness="0,0,0,1" Padding="4,8">
                                                <Grid>
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="56"/><ColumnDefinition Width="56"/><ColumnDefinition Width="60"/></Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Name}" Foreground="#D9E1E7" TextTrimming="CharacterEllipsis"/>
                                                    <TextBlock Grid.Column="1" Text="{Binding CountA}" Foreground="#A9B6C1" TextAlignment="Center"/>
                                                    <TextBlock Grid.Column="2" Text="{Binding CountB}" Foreground="#A9B6C1" TextAlignment="Center"/>
                                                    <TextBlock Grid.Column="3" Text="{Binding DifferenceText}" Foreground="{Binding DifferenceColor}" FontWeight="SemiBold" TextAlignment="Center"/>
                                                </Grid>
                                            </Border>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>

                <!-- Validation -->
                <Grid x:Name="ValidationPage" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="82"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid Margin="2,0,2,10"><StackPanel VerticalAlignment="Center"><TextBlock Text="Harita Doğrulama" Style="{StaticResource PageTitle}"/><TextBlock Text="Seçili kuralların haritadaki sonucunu kontrol edin." Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0"/></StackPanel><Button Style="{StaticResource PrimaryButton}" Content="Yenile" HorizontalAlignment="Right" VerticalAlignment="Center" Padding="18,9" Click="Validate_Click"/></Grid>
                    <Grid Grid.Row="1"><Grid.RowDefinitions><RowDefinition Height="92"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                        <Grid><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
                            <Border Style="{StaticResource Card}" Padding="16"><StackPanel><TextBlock Text="KURAL" Style="{StaticResource SectionTitle}"/><TextBlock x:Name="ValidationTotalText" Text="0" Style="{StaticResource Metric}"/></StackPanel></Border>
                            <Border Grid.Column="2" Style="{StaticResource Card}" Padding="16"><StackPanel><TextBlock Text="BAŞARILI" Style="{StaticResource SectionTitle}"/><TextBlock x:Name="ValidationSuccessText" Text="0" Style="{StaticResource Metric}" Foreground="{StaticResource SuccessBrush}"/></StackPanel></Border>
                            <Border Grid.Column="4" Style="{StaticResource Card}" Padding="16"><StackPanel><TextBlock Text="SORUN" Style="{StaticResource SectionTitle}"/><TextBlock x:Name="ValidationErrorText" Text="0" Style="{StaticResource Metric}" Foreground="{StaticResource ErrorBrush}"/></StackPanel></Border>
                        </Grid>
                        <Border Grid.Row="1" Style="{StaticResource Card}" Margin="0,12,0,0" Padding="18"><RichTextBox x:Name="ValidationText" IsReadOnly="True" IsDocumentEnabled="False" Background="Transparent" BorderThickness="0" Padding="0" FontFamily="Segoe UI Variable Text" FontSize="13" VerticalScrollBarVisibility="Auto"><FlowDocument PagePadding="0"/></RichTextBox></Border>
                    </Grid>
                </Grid>
                <!-- Settings -->
                <Grid x:Name="SettingsPage" Visibility="Collapsed">
                    <Grid.RowDefinitions><RowDefinition Height="86"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <StackPanel Margin="2,0,2,12" VerticalAlignment="Center">
                        <TextBlock Text="Uygulama Ayarları" Style="{StaticResource PageTitle}"/>
                        <TextBlock Text="Harita üretiminde kullanılan klasörleri ve aktif ayar dosyasını yönetin." Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0"/>
                    </StackPanel>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <StackPanel HorizontalAlignment="Left" MaxWidth="1550">
                            <Border Style="{StaticResource Card}" Margin="0,0,0,12" Padding="18">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Top">
                                        <TextBlock Text="RUST SUNUCU KLASÖRÜ" Style="{StaticResource SectionTitle}" Margin="0,0,0,6"/>
                                        <TextBlock Text="RustDedicated sunucunuzun ana klasörü." Foreground="#D4DCE3" FontWeight="SemiBold" FontSize="13"/>
                                        <TextBlock Text="Harita üretiminde gereken Rust dosyaları bu konumdan kullanılır." Foreground="{StaticResource MutedBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,5,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <TextBox x:Name="RustPathBox" IsReadOnly="True" FontFamily="Cascadia Mono" FontSize="11" ToolTip="Rust sunucu klasörü"/>
                                        <Button Style="{StaticResource ButtonBase}" Content="Klasörü Değiştir" Margin="0,10,0,0" HorizontalAlignment="Left" Padding="14,8" Click="BrowseRust_Click"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource Card}" Margin="0,0,0,12" Padding="18">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Top">
                                        <TextBlock Text="HARİTA ÇIKTI KLASÖRÜ" Style="{StaticResource SectionTitle}" Margin="0,0,0,6"/>
                                        <TextBlock Text="Üretilen MAP ve PNG dosyalarının kaydedileceği klasör." Foreground="#D4DCE3" FontWeight="SemiBold" FontSize="13" TextWrapping="Wrap"/>
                                        <TextBlock Text="Varsayılan Maps klasörünü kullanabilir veya farklı bir konum seçebilirsiniz." Foreground="{StaticResource MutedBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,5,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <TextBox x:Name="OutputPathBox" IsReadOnly="True" FontFamily="Cascadia Mono" FontSize="11" ToolTip="Harita çıktı klasörü"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                            <Button Style="{StaticResource ButtonBase}" Content="Klasörü Değiştir" Padding="14,8" Click="BrowseOutput_Click"/>
                                            <Button Style="{StaticResource ButtonBase}" Content="Çıktı Klasörünü Aç" Padding="14,8" Margin="8,0,0,0" Click="OpenMaps_Click"/>
                                            <Button Style="{StaticResource ButtonBase}" Content="Varsayılana Dön" Padding="14,8" Margin="8,0,0,0" Click="ResetOutput_Click"/>
                                        </StackPanel>
                                        <TextBlock x:Name="DefaultMapsText" Foreground="#718190" FontSize="9" Margin="2,9,2,0" TextWrapping="Wrap"/>
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <Border Style="{StaticResource Card}" Padding="18">
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="300"/><ColumnDefinition Width="24"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Top">
                                        <TextBlock Text="AKTİF HARİTA" Style="{StaticResource SectionTitle}" Margin="0,0,0,6"/>
                                        <TextBlock x:Name="SettingsActiveMapName" Text="RavenHarita" Foreground="#F1F5F8" FontWeight="SemiBold" FontSize="15"/>
                                        <TextBlock Text="Bu haritaya ait ayar kaydının konumunu buradan kontrol edebilirsiniz." Foreground="{StaticResource MutedBrush}" FontSize="10" TextWrapping="Wrap" Margin="0,6,0,0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                        <TextBlock Text="Harita ayar dosyası" Foreground="{StaticResource MutedBrush}" FontSize="10" Margin="1,0,0,5"/>
                                        <TextBox x:Name="CurrentProjectText" IsReadOnly="True" FontFamily="Cascadia Mono" FontSize="10" TextWrapping="Wrap" MinHeight="48" VerticalContentAlignment="Top"/>
                                        <Button Style="{StaticResource ButtonBase}" Content="Ayar Dosyasının Konumunu Aç" Padding="14,8" Margin="0,10,0,0" HorizontalAlignment="Left" Click="OpenCurrentProjectFolder_Click"/>
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <!-- Logs -->
                <Grid x:Name="LogsPage" Visibility="Collapsed"><Grid.RowDefinitions><RowDefinition Height="80"/><RowDefinition Height="*"/></Grid.RowDefinitions><Grid><StackPanel><TextBlock Text="Üretim Logları" Style="{StaticResource PageTitle}"/><TextBlock Text="Harita üretimi sırasında oluşan mesajları görüntüleyin." Foreground="{StaticResource MutedBrush}"/></StackPanel><Button Style="{StaticResource ButtonBase}" Content="Temizle" HorizontalAlignment="Right" VerticalAlignment="Center" Click="ClearLog_Click"/></Grid><Border Grid.Row="1" Style="{StaticResource Card}"><TextBox x:Name="FullLog" IsReadOnly="True" AcceptsReturn="True" Background="Transparent" BorderThickness="0" Foreground="#9BC8AE" FontFamily="Cascadia Mono" FontSize="12" VerticalScrollBarVisibility="Auto"/></Border></Grid>
            </Grid>
        </Grid>
        <Border Grid.Row="2" Background="#0A0F15" BorderBrush="#202A34" BorderThickness="0,1,0,0"><Grid Margin="14,0"><TextBlock x:Name="BottomStatus" Text="Hazır" Foreground="#7F8B98" VerticalAlignment="Center" FontSize="10"/></Grid></Border>
    </Grid>
</Window>
