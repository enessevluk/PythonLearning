<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>RavenMapPanel</AssemblyName>
    <RootNamespace>RavenMapPanel</RootNamespace>
    <Version>3.7.0</Version>
    <FileVersion>3.7.0.0</FileVersion>
    <ApplicationIcon>Assets\raven-brand-v2.ico</ApplicationIcon>
    <DebugType>none</DebugType>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="..\RavenMapPanel.Core\Models.cs" Link="Core\Models.cs" />
    <Compile Include="..\RavenMapPanel.Core\SettingsStore.cs" Link="Core\SettingsStore.cs" />
    <Compile Include="..\RavenMapPanel.Core\AssetStore.cs" Link="Core\AssetStore.cs" />
    <Compile Include="..\RavenMapPanel.Core\OverlayService.cs" Link="Core\OverlayService.cs" />
    <Compile Include="..\RavenMapPanel.Core\GenerationService.cs" Link="Core\GenerationService.cs" />
    <Resource Include="Assets\icons\*.png" />
    <Resource Include="Assets\backgrounds\*.jpg" />
    <Resource Include="Assets\mapico.ico" />
    <Resource Include="Assets\raven-brand-v2.png" />
    <Resource Include="Assets\raven-brand-v2.ico" />
    <EmbeddedResource Include="Assets\icons\*.png" />
    <EmbeddedResource Include="Assets\config\*" />
    <EmbeddedResource Include="Assets\custom_prefabs\*.map" />
    <EmbeddedResource Include="Assets\HarmonyMods\*.dll" />
  </ItemGroup>
</Project>
